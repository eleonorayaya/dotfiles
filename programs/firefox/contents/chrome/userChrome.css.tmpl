:root {
  color-scheme: {{.Type}} !important;
  --toolbox-background-color: {{.Colors.SurfaceHighlight}} !important;
  --toolbox-background-color-inactive: {{.Colors.SurfaceVariant}} !important;
  --toolbox-text-color: {{.Colors.TextOnSurface}} !important;
  --toolbox-text-color-inactive: {{.Colors.TextOnSurfaceMuted}} !important;
  --toolbar-background-color: {{.Colors.Surface}} !important;
  --toolbar-text-color: {{.Colors.TextOnSurface}} !important;
  --toolbarbutton-icon-fill: {{.Colors.Primary}} !important;
  --toolbar-field-background-color: {{.Colors.SurfaceVariant}} !important;
  --toolbar-field-text-color: {{.Colors.TextOnSurface}} !important;
  --toolbar-field-background-color-focus: {{.Colors.Surface}} !important;
  --toolbar-field-text-color-focus: {{.Colors.TextOnSurface}} !important;
  --toolbar-field-border-color-focus: {{.Colors.Primary}} !important;
  --urlbar-box-background-color: {{.Colors.SurfaceHighlight}} !important;
  --focus-outline-color: {{.Colors.Primary}} !important;
  --chrome-content-separator-color: {{.Colors.SurfaceBorder}} !important;
  --panel-background-color: {{.Colors.Surface}} !important;
  --panel-text-color: {{.Colors.TextOnSurface}} !important;
  --panel-border-color: {{.Colors.SurfaceBorder}} !important;
  --sidebar-background-color: {{.Colors.SurfaceVariant}} !important;
  --sidebar-text-color: {{.Colors.TextOnSurface}} !important;
  --color-accent-primary: {{.Colors.Primary}} !important;
  --link-color: {{.Colors.Link}} !important;
  --tab-background-color-selected: {{.Colors.Surface}} !important;
  --tab-text-color-selected: {{.Colors.Primary}} !important;
  --tab-border-color-selected: {{.Colors.Primary}} !important;
  --tab-border-color-selected-leading: {{.Colors.Primary}} !important;
  --tab-border-color-selected-trailing: {{.Colors.Primary}} !important;
}

#navigator-toolbox {
  background-color: var(--toolbox-background-color) !important;
}

#navigator-toolbox:-moz-window-inactive {
  background-color: var(--toolbox-background-color-inactive) !important;
}

.tabbrowser-tab[selected] .tab-label {
  font-weight: 700 !important;
}
